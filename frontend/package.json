{
  "name": "dungeon-master",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare:vision": "node scripts/prepare-vision-assets.mjs",
    "predev": "npm run prepare:vision",
    "prebuild": "npm run prepare:vision",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
