# Install as /etc/dungeon-master/runtime.env, mode 600. Never commit real values.
POSTGRES_USER=dungeon_master
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
POSTGRES_DB=dungeon_master
DATABASE_URL=postgresql+asyncpg://dungeon_master:REPLACE_WITH_RANDOM_HEX_PASSWORD@postgres:5432/dungeon_master
SECRET_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://DOMAIN
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_RU=eleven_flash_v2_5
ELEVENLABS_MODEL_EN=eleven_flash_v2_5
ELEVENLABS_MODEL_KK=eleven_v3
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=20
ELEVENLABS_MAX_CONCURRENCY=2
ENABLE_DEMO_PERSONAS=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
MAX_DOCUMENTS_PER_USER=5
MAX_DOCUMENT_SIZE_MB=5
MAX_EXTRACTED_CHARS=50000
