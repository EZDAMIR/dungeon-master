# Application
APP_NAME=dungeon_master
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-before-deploying
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dungeon_master

# Test database (used by pytest; isolated from the main database)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dungeon_master_test

# HTTP client
HTTP_CLIENT_TIMEOUT=30.0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File upload
MAX_UPLOAD_SIZE_MB=10

# AI providers (disabled without a key; live is never simulated)
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
ENABLE_DEMO_PERSONAS=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
MAX_DOCUMENTS_PER_USER=5
MAX_DOCUMENT_SIZE_MB=5
MAX_EXTRACTED_CHARS=50000

# Sprint 4B execution, bounded providers and durable generation jobs
COACH_EXECUTION_MODE=live
ENABLE_FIXTURE_MODE=false
OPENAI_REASONING_EFFORT_CHAT=low
OPENAI_REASONING_EFFORT_PLAN=medium
OPENAI_OUTPUT_CHAT=1800
OPENAI_OUTPUT_PROFILE=4000
OPENAI_OUTPUT_PLAN=8000
OPENAI_OUTPUT_SPEC=10000
COACH_MAX_TOOL_ROUNDS=4
COACH_DAILY_REQUEST_CAP=60
PROVIDER_IP_DAILY_REQUEST_CAP=300
OPENAI_MAX_CONCURRENCY=4
GENERATION_JOB_TIMEOUT_SECONDS=180
GENERATION_JOB_CONCURRENCY=1

# Optional account voices, no cloning; KK must pass actual model language checks
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_RU=eleven_flash_v2_5
ELEVENLABS_MODEL_EN=eleven_flash_v2_5
ELEVENLABS_MODEL_KK=eleven_v3
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=20
ELEVENLABS_MAX_CONCURRENCY=2
AUDIO_CACHE_MAX_MB=100
PERSONAL_AUDIO_TTL_SECONDS=3600
AUDIO_DAILY_CHARACTER_CAP=10000
VOICE_INPUT_ENABLED=true
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_INPUT_MAX_SECONDS=30
VOICE_INPUT_MAX_BYTES=4194304

# Optional real OAuth; connection requires encrypted tokens and owner consent
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_TOKEN_ENCRYPTION_KEY=

# Stable guest ownership; configure the trusted origin for cookies/CSRF
GUEST_REFRESH_TTL_DAYS=7
APP_PUBLIC_URL=
